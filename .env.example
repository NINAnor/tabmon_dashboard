# Copy to .env and fill in. Never commit .env.

# Team-area login (served by the API, stored as a signed HTTP-only cookie)
DASHBOARD_USERNAME=tabmon
DASHBOARD_PASSWORD=
# Long random string, e.g. `openssl rand -hex 32`
SESSION_SECRET=
# Set to true when the site is served over HTTPS
COOKIE_SECURE=false

# Only needed for `docker compose run --rm preprocessing`
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=s3.nird.sigma2.no

# Nightly data refresh (cron syntax, UTC). Default: 02:00 every night.
NIGHTLY_SCHEDULE=0 2 * * *
