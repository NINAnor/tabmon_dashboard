# Copy to .env and fill in. Never commit .env.

# Team-area login (served by the API, stored as a signed HTTP-only cookie)
DASHBOARD_USERNAME=tabmon
DASHBOARD_PASSWORD=
# Long random string, e.g. `openssl rand -hex 32`
SESSION_SECRET=
# Set to true when the site is served over HTTPS
COOKIE_SECURE=false

# Optional S3 overrides. If unset, access_key_id, secret_access_key, and endpoint
# are read from the [nirds3] section of the rclone config file.
# S3_BUCKET=bencretois-ns8129k-proj-tabmon
# S3_ENDPOINT=https://s3.nird.sigma2.no
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
